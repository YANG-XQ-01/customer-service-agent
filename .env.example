# ===== 大模型（通义千问 / 阿里云百炼）=====
# 在阿里云百炼控制台创建 API Key：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-请替换为你的密钥
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
# 回答随机性：0 最稳定，1 最发散（客服场景可调低）
LLM_TEMPERATURE=0.7

# 每个会话最多记住的轮数（1 轮 = 用户 1 句 + 助手 1 句）
MEMORY_MAX_TURNS=10

# 退款金额超过该阈值（元）时转人工审核
REFUND_THRESHOLD=500

# ===== MySQL（订单 / 售后数据）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 本地开发可直接用 root；生产环境务必换成专用低权限账号
MYSQL_USER=root
MYSQL_PASSWORD=请替换为你的密码
MYSQL_DB=customer_service

# ===== Milvus（商品 / 政策知识向量库）=====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=customer_service_kb

# ===== Redis（用户体系 / 会话与聊天记录缓存）=====
# 本机开发连你已有的 Redis（旧项目容器映射在 6380）；容器内会用服务名 redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
# 聊天记录保留 7 天；登录令牌保留 7 天
CHAT_HISTORY_TTL=604800
TOKEN_TTL=604800
# 工单保留 30 天
TICKET_TTL=2592000

# 限流与登录安全
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
